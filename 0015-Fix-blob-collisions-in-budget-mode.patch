diff --git a/lib/gl_tail/engine.rb b/lib/gl_tail/engine.rb
index 664fe6e..ac52baa 100644
--- a/lib/gl_tail/engine.rb
+++ b/lib/gl_tail/engine.rb
@@ -135,7 +135,7 @@ module GlTail
       limits = []
       max = @config.screen.max_colliding_blobs.to_i
       limits << max if max > 0
-      limits << @collide_limit.to_i if frame_budget?
+      limits << (@collide_limit ||= 1000.0).to_i if frame_budget?
       limits.min
     end
 
@@ -174,7 +174,10 @@ module GlTail
         @space.remove_shape(activity.shape)
         activity.shape_in_space = false
       end
-      activity.shape.group = on ? 0 : 1 # same non-zero group = no contacts
+      # Passive blobs share a group (same group = no contacts between them);
+      # colliding ones have none. nil is "no group" - the Ruby wrapper turns
+      # any other value, 0 included, into a non-zero group via its object_id.
+      activity.shape.group = on ? nil : 1
       activity.collider = on
 
       list_add(on ? colliding_list : passive_list, activity)
diff --git a/vendor/chipmunk/ext/chipmunk/rb_cpShape.c b/vendor/chipmunk/ext/chipmunk/rb_cpShape.c
index a8db5cc..ae7885a 100644
--- a/vendor/chipmunk/ext/chipmunk/rb_cpShape.c
+++ b/vendor/chipmunk/ext/chipmunk/rb_cpShape.c
@@ -106,9 +106,10 @@ rb_cpShapeGetGroup(VALUE self) {
 
 static VALUE
 rb_cpShapeSetGroup(VALUE self, VALUE val) {
-  VALUE col_type = rb_obj_id(val);
   rb_iv_set(self, "group", val);
-  SHAPE(self)->group = NUM2UINT(col_type);
+  // glTail: nil means "no group" (CP_NO_GROUP). Any other object is
+  // identified by its object_id, which is never 0, not even for 0 itself.
+  SHAPE(self)->group = NIL_P(val) ? CP_NO_GROUP : NUM2UINT(rb_obj_id(val));
 
   return val;
 }
