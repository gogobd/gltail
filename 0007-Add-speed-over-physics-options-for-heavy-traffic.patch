@@ -153,5 +157,10 @@ end
 
 config = GlTail::Config.parse_yaml(file, overrides)
 
+if defined? @fast
+  config.screen.blob_collisions = false
+  config.screen.max_blobs = 2000 if config.screen.max_blobs.to_i <= 0
+end
+
 engine = GlTail::Engine.new(config)
 engine.start
