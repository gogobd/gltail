From 7b5c17e7fb2586d7031820fef93c82986b8844fd Mon Sep 17 00:00:00 2001
From: gogo <gogo@bluedynamics.com>
Date: Tue, 6 Oct 2026 15:29:20 +0200
Subject: [PATCH 09/11] Add --per-second / rate_unit: second to show rates as
 r/s

Rates are tracked per second internally; only the display changes.

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
Claude-Session: https://claude.ai/code/session_013kYwHzrj5ef427USqzf3UF
---
 README                 | 1 +
 bin/gl_tail            | 7 +++++++
 dist/config.yaml       | 1 +
 lib/gl_tail/config.rb  | 6 ++++++
 lib/gl_tail/element.rb | 5 +++--
 5 files changed, 18 insertions(+), 2 deletions(-)

diff --git a/README b/README
index 20b859a..8edfdb8 100644
--- a/README
+++ b/README
@@ -26,6 +26,7 @@ Piping logs in (like logstalgia):
     ssh me@server docker logs --follow --tail 1 web | bundle exec ruby bin/gl_tail --stdin --name web
     ssh me@server tail -f /var/log/nginx/access.log | bundle exec ruby bin/gl_tail --stdin --parser nginx
 
+  --per-second shows rates as requests per second (r/s) instead of per minute.
   --parser picks the log format (default: apache; --parsers lists them all),
   --name sets the site name shown. Add a config file argument to use its
   screen/column settings. If the container logs requests to stderr, add 2>&1
diff --git a/bin/gl_tail b/bin/gl_tail
index 1be881a..9cfb315 100755
--- a/bin/gl_tail
+++ b/bin/gl_tail
@@ -42,6 +42,7 @@ ARGV.each do |arg|
          '[--stdin|-]        Read log lines from stdin instead of the servers in the config',
          '[--parser|-P NAME] Parser for --stdin (default: apache; see --parsers)',
          '[--name|-N NAME]   Site name shown for --stdin (default: stdin)',
+         '[--per-second]     Show rates as requests per second (r/s) instead of r/m',
          '[--fast]           Under heavy load, run physics every 2nd/3rd frame',
          '                   instead of every frame (physics_rate: auto)',
          '[configfile]       The YAML config file you wish to load (default = gl_tail.yaml;',
@@ -54,6 +55,8 @@ ARGV.each do |arg|
     @stdin = true
   when '-fast', '--fast'
     @fast = true
+  when '--per-second', '-per-second'
+    @per_second = true
   when '-version', '--version'
     @print = :version
   when '-new', '--new', '-n'
@@ -161,5 +164,9 @@ if defined? @fast
   config.screen.physics_rate = 'auto'
 end
 
+if defined? @per_second
+  config.screen.rate_unit = 'second'
+end
+
 engine = GlTail::Engine.new(config)
 engine.start
diff --git a/dist/config.yaml b/dist/config.yaml
index fe28a7d..d76a07a 100644
--- a/dist/config.yaml
+++ b/dist/config.yaml
@@ -29,6 +29,7 @@ config:
     max_blob_size: 0.04
     highlight_color: orange
     bounce: false
+    # rate_unit: second        # show r/s instead of r/m (or start with --per-second)
     # Performance under heavy traffic:
     # physics_rate: auto       # 1 = physics every frame; 2/3 = every 2nd/3rd frame;
     #                          # auto = only when busy (same as --fast)
diff --git a/lib/gl_tail/config.rb b/lib/gl_tail/config.rb
index 26dd47f..5f9355d 100644
--- a/lib/gl_tail/config.rb
+++ b/lib/gl_tail/config.rb
@@ -174,6 +174,12 @@ module GlTail
 
     config_attribute :physics_rate, 'Run the physics every Nth frame (1 = every frame, the default; 2-3 = cheaper, slightly less accurate bounces), or "auto" to drop to every 2nd/3rd frame only while the physics is expensive.'
 
+    config_attribute :rate_unit, 'Show rates per "minute" (r/m, the default) or per "second" (r/s)'
+
+    def rate_per_second?
+      %w[second seconds s sec].include?(rate_unit.to_s.downcase)
+    end
+
     def blob_collisions?
       !(blob_collisions == false || blob_collisions.to_s.downcase == 'false')
     end
diff --git a/lib/gl_tail/element.rb b/lib/gl_tail/element.rb
index b9b88cd..3bc79eb 100644
--- a/lib/gl_tail/element.rb
+++ b/lib/gl_tail/element.rb
@@ -228,10 +228,11 @@ class Element
 
     case @block.show
     when 0
+      per_second = engine.screen.rate_per_second?
       if @rate == 0
-        txt = '     r/m '
+        txt = per_second ? '     r/s ' : '     r/m '
       else
-        txt = "#{sprintf('%8.2f',@rate * 60)} "
+        txt = "#{sprintf('%8.2f', per_second ? @rate : @rate * 60)} "
       end
     when 1
       if @total == 0
-- 
2.43.0

